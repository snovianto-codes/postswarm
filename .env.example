GEMINI_API_KEY=your_gemini_api_key_here

# Optional — only needed if config/models.yaml assigns an agent to one of
# these providers. Leave blank/unset otherwise; core/model_client.py only
# reads a key when a role is actually configured to use that provider.
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
